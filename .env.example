OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
AI_ENABLED=false
OPENAI_TIMEOUT_SECONDS=90
LOCAL_AUTO_THRESHOLD=0.82
LOCAL_MIN_GAP=0.12
MAX_UPLOAD_MB=50
EXPOSE_API_DOCS=false
